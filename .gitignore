########################################
# Monorepo: DroneBatteries
# Backend (Python/FastAPI) + Frontend (React/Vite)
########################################

# Local folders not tracked in this repo
__MACOSX/
battery_admin/

########################################
# Python (backend)
########################################
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging / build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
parts/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Test / coverage
.pytest_cache/
.coverage
coverage/
htmlcov/
*.lcov

# Environment files (keep example files tracked)
.env
.env.*
!.env.example

########################################
# Node.js / React (frontend)
########################################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Caches
.cache
.parcel-cache
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Build outputs
# (Vite/React uses dist by default)
dist/
build/
out/

# Framework outputs (safe if not used)
.next/
.nuxt/
.docusaurus/
.vuepress/dist/
.temp/

# Public outputs for some frameworks (safe if not used here)
public/

########################################
# IDEs and editors
########################################
.vscode/
.idea/
*.swp
*.swo
*~

########################################
# OS files
########################################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

